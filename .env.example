# Server configuration. Copy this file to .env and set a unique secret.
PORT=3000
# Generate a value with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must be at least 32 characters. Never commit the actual value.
JWT_SECRET=

# PostgreSQL connection string. Never commit a real credential.
# Example: postgresql://codemagic:change-me@localhost:5432/codemagic
DATABASE_URL=
